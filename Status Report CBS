    document.getElementById('card-kpi-late-start').addEventListener('click', () => {
      cardFilter = cardFilter === 'late_start' ? null : 'late_start';
      render();
    });

    document.getElementById('btn-clear-card-filter').addEventListener('click', () => {
      cardFilter = null;
      render();
    });

    // Botões de Ação
    document.getElementById('btn-sync-sharepoint').addEventListener('click', () => {
      carregarDadosExcel(LOCAL_FALLBACK_FILE);
    });

    document.getElementById('file-input').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const buffer = evt.target.result;
          const workbook = XLSX.read(buffer, { type: 'array' });
          processWorkbook(workbook);
          document.getElementById('status-sincronizacao').innerText = `Carregado ficheiro local: ${file.name}`;
        } catch (err) {
          alert('Erro ao processar ficheiro Excel (.xlsx).');
        }
      };
      reader.readAsArrayBuffer(file);
    });

    window.addEventListener('DOMContentLoaded', () => {
      carregarDadosExcel(LOCAL_FALLBACK_FILE);
    });
  </script>
</body>
</html>
